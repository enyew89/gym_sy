# ==============================================================
# GymPro Server Environment Variables Template
# Copy this to .env locally or set these in Render Environment Variables
# ==============================================================

PORT=10000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gympro?retryWrites=true&w=majority
SESSION_SECRET=replace_with_a_long_random_secret_string_for_sessions_2026

# When deployed as a single service on Render, leave CLIENT_URL blank or set to your Render URL
CLIENT_URL=https://your-app-name.onrender.com

# ==============================================================
# MASTER ADMIN INITIAL CREDENTIALS (SET BEFORE FIRST BOOT)
# ==============================================================
ADMIN_NAME="Abebe Kebede"
ADMIN_EMAIL=admin@gympro.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_PHONE=+251911223344

# ==============================================================
# PAYMENT GATEWAY: CHAPA
# ==============================================================
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx

# ==============================================================
# AI FITNESS COACH: GOOGLE GEMINI API
# ==============================================================
GEMINI_API_KEY=AIzaSy...
# Or multiple comma-separated keys for auto-failover:
# GEMINI_API_KEYS=key1,key2,key3
